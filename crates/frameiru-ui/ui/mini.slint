// Picture-in-picture mini preview: an always-on-top, frameless window that
// mirrors the live preview while the main window is minimized. The app
// positions it at the bottom-right of the desktop work area (X11) and the
// user can drag it anywhere via WindowMoveArea.
export component MiniPreview inherits Window {
    title: "Frameiru Mini Preview";
    preferred-width: 300px;
    preferred-height: 225px; // 4:3, matches the 640x480 pipeline preview
    no-frame: true;
    always-on-top: true;
    background: #0c0d12;

    in-out property <image> preview;

    callback close_clicked();

    Rectangle {
        border-color: #00f0ff;
        border-width: 1px;
        border-radius: 8px;
        background: #0c0d12;
        clip: true;

        // Live preview mirror.
        Image {
            source: root.preview;
            image-fit: contain;
            width: 100%;
            height: 100%;
        }

        // Drag strip: anywhere on the window moves it (WindowMoveArea keeps
        // child elements like the close button interactive).
        WindowMoveArea {
            width: 100%;
            height: 100%;

            // Top strip: brand label + close button.
            Rectangle {
                y: 0px;
                width: 100%;
                height: 24px;
                background: #12151c;
                opacity: 0.92;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;

                    Text {
                        text: "FRAMEIRU";
                        font-size: 9px;
                        font-weight: 800;
                        letter-spacing: 1.2px;
                        color: #00f0ff;
                        vertical-alignment: center;
                    }

                    // Close (dismisses until the main window is un-minimized).
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 3px;
                        background: #181b24;
                        TouchArea {
                            clicked => { root.close_clicked(); }
                            Rectangle {
                                width: 8px;
                                height: 1px;
                                background: #94a3b8;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
            }
        }
    }
}