// System tray icon + menu. Keeps Frameiru alive when the window is closed
// (close-to-tray): a visible SystemTrayIcon holds the event loop keepalive.
export component FrameiruTray inherits SystemTrayIcon {
    icon: @image-url("tray-icon.png");
    tooltip: "Frameiru";
    title: "Frameiru";

    // Truth source for the PiP toggle; the app flips it and the platform
    // menu is rebuilt on change.
    in-out property <bool> mini_preview_checked: false;

    clicked => { root.show_window(); }

    Menu {
        MenuItem {
            title: "Show Frameiru";
            activated => { root.show_window(); }
        }
        MenuItem {
            // ksni (Linux SNI tray) cannot render checkmarks, so the state is
            // reflected in the title; checkable/checked still drive native
            // checkmarks on macOS/Windows via muda.
            title: root.mini_preview_checked
                ? "✓ Mini preview when minimized"
                : "Mini preview when minimized";
            checkable: true;
            checked: root.mini_preview_checked;
            activated => { root.toggle_mini_preview(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }

    callback show_window();
    callback toggle_mini_preview();
    callback quit();
}